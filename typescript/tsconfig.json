{
  "compilerOptions": {
    "target": "ES2022",

    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,

    "esModuleInterop": true,
    "resolveJsonModule": true,

    "types": [
      "node",
      "@playwright/test"
    ],

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },

  "include": [
    "**/*.ts"
  ],

  "exclude": [
    "node_modules",
    "test-results",
    "playwright-report"
  ]
}